<Window x:Class="CrosshairOverlay.Controls.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Overlay"
        Width="308"
        Height="86"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Opacity="0"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="ToastCloseButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Host" Margin="10,5" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="18" />
        </Grid.RenderTransform>

        <Border x:Name="Chrome"
                CornerRadius="13"
                BorderBrush="#3D2759"
                BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F21E1232" Offset="0" />
                    <GradientStop Color="#F2160C26" Offset="0.55" />
                    <GradientStop Color="#F20C0616" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#B45CFF"
                                  BlurRadius="24"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.35"
                                  RenderingBias="Performance" />
            </Border.Effect>

            <Grid>
                <!-- Soft aurora highlight, clipped by the rounded border -->
                <Border CornerRadius="15" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.92,0"
                                             GradientOrigin="0.92,0"
                                             RadiusX="0.75"
                                             RadiusY="0.95">
                            <GradientStop Color="#55C56CFF" Offset="0" />
                            <GradientStop Color="#00C56CFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Grid x:Name="ContentRoot" Margin="10,9,8,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadge"
                            Width="30"
                            Height="30"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            Background="#33C56CFF"
                            BorderBrush="#55C56CFF"
                            BorderThickness="1">
                        <TextBlock x:Name="IconText"
                                   Text="i"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Заголовок"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MessageText"
                                   Text="Сообщение"
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   MaxHeight="26"
                                   LineHeight="13" />
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Content="✕"
                            Style="{StaticResource ToastCloseButton}"
                            VerticalAlignment="Top"
                            ToolTip="Закрыть" />
                </Grid>

                <!-- Progress bar: shrinks with the toast lifetime and doubles as the timer -->
                <Border Height="3"
                        CornerRadius="2"
                        Background="#33FFFFFF"
                        VerticalAlignment="Bottom"
                        Margin="10,0,10,5"
                        IsHitTestVisible="False">
                    <Border x:Name="ProgressFill"
                            HorizontalAlignment="Stretch"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C56CFF" Offset="0" />
                                <GradientStop Color="#DB9BFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressFillScale" ScaleX="1" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
