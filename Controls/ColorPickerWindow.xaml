<Window x:Class="CrosshairOverlay.Controls.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор цвета"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="PickerCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PickerLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="MiniSwatch" TargetType="Button" BasedOn="{StaticResource SwatchButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <DrawingBrush x:Key="PickerCheckerBrush" TileMode="Tile"
                      Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#120A1D" Geometry="M0,0 H12 V12 H0 Z" />
                    <GeometryDrawing Brush="#1E1230" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <LinearGradientBrush x:Key="HueBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0000" Offset="0" />
            <GradientStop Color="#FFFF00" Offset="0.1667" />
            <GradientStop Color="#00FF00" Offset="0.3333" />
            <GradientStop Color="#00FFFF" Offset="0.5" />
            <GradientStop Color="#0000FF" Offset="0.6667" />
            <GradientStop Color="#FF00FF" Offset="0.8333" />
            <GradientStop Color="#FF0000" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="Root"
          Margin="6"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.97" ScaleY="0.97" />
        </Grid.RenderTransform>

        <Border CornerRadius="18"
                BorderBrush="{StaticResource NeonBorderBrush}"
                BorderThickness="1.5"
                Background="{StaticResource WindowGradientBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#B45CFF"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.45"
                                  RenderingBias="Performance" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0"
                      Height="50"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Grid Width="18" Height="18" Margin="0,0,10,0">
                            <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" />
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#C56CFF" BlurRadius="10" ShadowDepth="0"
                                                      Opacity="0.9" RenderingBias="Performance" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ВЫБОР ЦВЕТА" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TargetText" Text="Основной цвет" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Style="{StaticResource PickerCaptionButton}"
                            Margin="0,0,14,0" Click="Cancel_Click" ToolTip="Закрыть" />
                </Grid>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="20,4,20,18">

                    <!-- Current / original preview -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="58" Height="58" CornerRadius="12"
                                BorderBrush="{StaticResource NeonBorderBrush}" BorderThickness="1"
                                Background="{StaticResource PickerCheckerBrush}">
                            <Border x:Name="CurrentSwatch" CornerRadius="10" Margin="3">
                                <Border.Effect>
                                    <DropShadowEffect Color="#B45CFF" BlurRadius="12" ShadowDepth="0"
                                                      Opacity="0.45" RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="НОВЫЙ ЦВЕТ" Style="{StaticResource PickerLabel}" Margin="0,0,0,2" />
                            <TextBlock x:Name="HexPreviewText" Text="#FFFFFF" FontSize="19"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="RgbText" Text="R 255   G 255   B 255" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="БЫЛО" Style="{StaticResource PickerLabel}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <Border Width="34" Height="34" CornerRadius="9"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Background="{StaticResource PickerCheckerBrush}">
                                <Border x:Name="OriginalSwatch" CornerRadius="8" Margin="2" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Saturation / value area -->
                    <TextBlock Text="НАСЫЩЕННОСТЬ И ЯРКОСТЬ" Style="{StaticResource PickerLabel}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="#1A1028">
                        <Grid x:Name="SvArea"
                              Height="190"
                              ClipToBounds="True"
                              Cursor="Cross"
                              MouseLeftButtonDown="SvArea_MouseLeftButtonDown"
                              MouseMove="SvArea_MouseMove"
                              MouseLeftButtonUp="SvArea_MouseLeftButtonUp"
                              SizeChanged="SvArea_SizeChanged">
                            <Rectangle x:Name="SvHueLayer" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="SvMarker" Width="16" Height="16"
                                         Stroke="#FFFFFFFF" StrokeThickness="2" Fill="Transparent">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="0"
                                                          Opacity="0.75" RenderingBias="Performance" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Hue bar -->
                    <TextBlock Text="ОТТЕНОК" Style="{StaticResource PickerLabel}" Margin="0,15,0,5" />
                    <Border Height="18" CornerRadius="9"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource HueBrush}">
                        <Canvas x:Name="HueArea"
                                Height="16"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                                MouseMove="HueArea_MouseMove"
                                MouseLeftButtonUp="HueArea_MouseLeftButtonUp"
                                SizeChanged="HueArea_SizeChanged">
                            <Border x:Name="HueMarker" Width="10" Height="22" CornerRadius="5"
                                    BorderBrush="#FFFFFFFF" BorderThickness="2"
                                    Background="#33000000"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="0"
                                                      Opacity="0.7" RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Border>

                    <!-- Hex input -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX" Style="{StaticResource PickerLabel}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="HexBox"
                                 Grid.Column="1"
                                 Height="34"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextChanged="HexBox_TextChanged"
                                 KeyDown="HexBox_KeyDown"
                                 ToolTip="Введите цвет в формате #RRGGBB" />
                    </Grid>

                    <!-- Quick presets -->
                    <TextBlock Text="БЫСТРЫЙ ВЫБОР" Style="{StaticResource PickerLabel}" Margin="0,16,0,6" />
                    <WrapPanel>
                        <Button Style="{StaticResource MiniSwatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="Preset_Click" ToolTip="#FFFFFF" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#FF3B30" Tag="#FF3B30" Click="Preset_Click" ToolTip="#FF3B30" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#FF9500" Tag="#FF9500" Click="Preset_Click" ToolTip="#FF9500" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#FFD60A" Tag="#FFD60A" Click="Preset_Click" ToolTip="#FFD60A" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#32D74B" Tag="#32D74B" Click="Preset_Click" ToolTip="#32D74B" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#64D2FF" Tag="#64D2FF" Click="Preset_Click" ToolTip="#64D2FF" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#0A84FF" Tag="#0A84FF" Click="Preset_Click" ToolTip="#0A84FF" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#BF5AF2" Tag="#BF5AF2" Click="Preset_Click" ToolTip="#BF5AF2" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#FF2D92" Tag="#FF2D92" Click="Preset_Click" ToolTip="#FF2D92" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#C56CFF" Tag="#C56CFF" Click="Preset_Click" ToolTip="#C56CFF" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#5A5A5E" Tag="#5A5A5E" Click="Preset_Click" ToolTip="#5A5A5E" />
                        <Button Style="{StaticResource MiniSwatch}" Background="#000000" Tag="#000000" Click="Preset_Click" ToolTip="#000000" />
                    </WrapPanel>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="#0E0718"
                        BorderBrush="#2A1743"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,17,17"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Выберите цвет на поле или введите HEX."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Отмена" Style="{StaticResource GhostButton}"
                                    Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click" />
                            <Button Content="Применить" Style="{StaticResource AccentButton}"
                                    Padding="16,7" Click="Apply_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
