<Window x:Class="CrosshairOverlay.Controls.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Overlay"
        Width="292"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="TrayItem" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E1B44" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#241436" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TrayText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TrayKeyChip" TargetType="Border">
            <Setter Property="Background" Value="#1A1028" />
            <Setter Property="BorderBrush" Value="#3E2759" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TrayKeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="TrayLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="10,4,0,5" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Host" Margin="12" Opacity="0" RenderTransformOrigin="1,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="MenuScale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="MenuSlide" Y="10" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="18"
                BorderBrush="{StaticResource NeonBorderBrush}"
                BorderThickness="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FA1E1232" Offset="0" />
                    <GradientStop Color="#FA160C26" Offset="0.55" />
                    <GradientStop Color="#FA0C0616" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#B45CFF"
                                  BlurRadius="26"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.4"
                                  RenderingBias="Performance" />
            </Border.Effect>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Height="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                        <Path Data="M 14 2 V 9 M 14 19 V 26 M 2 14 H 9 M 19 14 H 26"
                              Stroke="{StaticResource AccentBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Effect>
                                <DropShadowEffect Color="#C56CFF"
                                                  BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.85"
                                                  RenderingBias="Performance" />
                            </Path.Effect>
                        </Path>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Crosshair Overlay"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Maltech"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <Border x:Name="StatusPill"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Background="#2AC56CFF"
                            BorderBrush="#55C56CFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,2">
                        <TextBlock x:Name="StatusPillText"
                                   Text="ВКЛ"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#2B1A42" Margin="4,0,4,6" />

                <!-- Settings -->
                <Button Grid.Row="2" Style="{StaticResource TrayItem}" Click="OpenSettings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE713;" Style="{StaticResource TrayIcon}" />
                        <TextBlock Grid.Column="1" Text="Открыть настройки" Style="{StaticResource TrayText}" Margin="10,0,8,0" />
                        <Border Grid.Column="2" Style="{StaticResource TrayKeyChip}">
                            <TextBlock x:Name="OpenKeyText" Text="F9" Style="{StaticResource TrayKeyText}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Toggle -->
                <Button Grid.Row="3" Style="{StaticResource TrayItem}" Click="Toggle_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ToggleIcon" Text="&#xE7B3;" Style="{StaticResource TrayIcon}" />
                        <TextBlock x:Name="ToggleText" Grid.Column="1" Text="Скрыть прицел" Style="{StaticResource TrayText}" Margin="10,0,8,0" />
                        <Border Grid.Column="2" Style="{StaticResource TrayKeyChip}">
                            <TextBlock x:Name="ToggleKeyText" Text="F8" Style="{StaticResource TrayKeyText}" />
                        </Border>
                    </Grid>
                </Button>

                <Border Grid.Row="4" Height="1" Background="#2B1A42" Margin="4,6,4,2" />

                <!-- Visibility mode -->
                <TextBlock Grid.Row="5" Text="РЕЖИМ ПОКАЗА" Style="{StaticResource TrayLabel}" />

                <StackPanel Grid.Row="6">
                    <Button Style="{StaticResource TrayItem}" Click="Always_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Stroke="#8A6BAE" StrokeThickness="1.6" />
                                <Ellipse x:Name="AlwaysDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Visibility="Collapsed">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#C56CFF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="Всегда" Style="{StaticResource TrayText}" Margin="10,0,0,0" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource TrayItem}" Click="Fullscreen_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Stroke="#8A6BAE" StrokeThickness="1.6" />
                                <Ellipse x:Name="FullscreenDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Visibility="Collapsed">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#C56CFF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="Только в полноэкранных приложениях" Style="{StaticResource TrayText}" Margin="10,0,0,0" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Exit is pinned to the bottom -->
                <StackPanel Grid.Row="7">
                    <Border Height="1" Background="#2B1A42" Margin="4,6,4,2" />
                    <Button Style="{StaticResource TrayItem}" Click="Exit_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource TrayIcon}" Foreground="#FF9AA8" />
                            <TextBlock Grid.Column="1" Text="Выход" Style="{StaticResource TrayText}" Foreground="#FF9AA8" Margin="10,0,0,0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
