<Application x:Class="CrosshairOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CrosshairOverlay.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Neon purple palette -->
            <SolidColorBrush x:Key="WindowBrush" Color="#160D25" />
            <SolidColorBrush x:Key="PanelBrush" Color="#211332" />
            <SolidColorBrush x:Key="InputBrush" Color="#100A1B" />
            <SolidColorBrush x:Key="BorderBrush" Color="#4A2E70" />
            <SolidColorBrush x:Key="TextBrush" Color="#F5EEFF" />
            <SolidColorBrush x:Key="MutedBrush" Color="#B49CD4" />
            <SolidColorBrush x:Key="AccentBrush" Color="#C56CFF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#DB9BFF" />
            <SolidColorBrush x:Key="PanelHoverBrush" Color="#33204C" />

            <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#221041" Offset="0" />
                <GradientStop Color="#150B26" Offset="0.5" />
                <GradientStop Color="#0B0614" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#24143A" Offset="0" />
                <GradientStop Color="#190E2A" Offset="0.6" />
                <GradientStop Color="#150B24" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NeonBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B2C8A" Offset="0" />
                <GradientStop Color="#C56CFF" Offset="0.35" />
                <GradientStop Color="#8A4BC4" Offset="0.65" />
                <GradientStop Color="#4B2375" Offset="1" />
            </LinearGradientBrush>

            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:StyleFeatureConverter x:Key="StyleFeature" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="CardSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Margin" Value="0,2,0,10" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="KeyCap" TargetType="Border">
                <Setter Property="Background" Value="#1A1028" />
                <Setter Property="BorderBrush" Value="#3E2759" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="KeyCapText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#2A1B40" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="ButtonGlow"
                                                          Color="#B45CFF"
                                                          BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0"
                                                          RenderingBias="Performance" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="HoverOverlay"
                                        Background="#1FFFFFFF"
                                        CornerRadius="8"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PressOverlay"
                                        Background="#33000000"
                                        CornerRadius="8"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.03" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.03" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.6" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="20" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.22" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="14" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#160D25" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Toggle switch -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="44" Height="24" Background="Transparent">
                                <Border x:Name="Track"
                                        CornerRadius="12"
                                        Background="#241537"
                                        BorderBrush="#4A2E70"
                                        BorderThickness="1" />
                                <Border x:Name="TrackOn"
                                        CornerRadius="12"
                                        Opacity="0"
                                        Background="{StaticResource AccentBrush}"
                                        BorderBrush="{StaticResource AccentHoverBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#B45CFF"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"
                                                          RenderingBias="Performance" />
                                    </Border.Effect>
                                </Border>
                                <Ellipse x:Name="Knob"
                                         Width="16"
                                         Height="16"
                                         Margin="4,0,0,0"
                                         HorizontalAlignment="Left"
                                         Fill="#B49CD4">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="0" To="20" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="20" To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#7A4CA8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ColorFieldButton" TargetType="Button">
                <Setter Property="Background" Value="#140C20" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#4A2E70" />
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="FieldGlow"
                                                      Color="#B45CFF"
                                                      BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0"
                                                      RenderingBias="Performance" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#C56CFF" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="FieldGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.55" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#4A2E70" Duration="0:0:0.22" />
                                                <DoubleAnimation Storyboard.TargetName="FieldGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#241437" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="5"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#5A3E7C" />
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <SolidColorBrush Color="Transparent" />
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="CheckGlow"
                                                          Color="#B45CFF"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0"
                                                          RenderingBias="Performance" />
                                    </Border.Effect>
                                    <Path x:Name="Check"
                                          Data="M 1 5 L 4.5 8.5 L 11 1"
                                          Width="12"
                                          Height="9"
                                          Stretch="Uniform"
                                          Stroke="#160D25"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Opacity="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="CheckScale" ScaleX="0.4" ScaleY="0.4" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="9,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Box"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#C56CFF" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Box"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#5A3E7C" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Box"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#C56CFF" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="Check"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="CheckGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.8" Duration="0:0:0.22" />
                                                <DoubleAnimation Storyboard.TargetName="CheckGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="14" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Box"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="Check"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.4" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="CheckScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.4" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="CheckGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="CheckGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="8" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderThumb" TargetType="Thumb">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="#FFFFFF">
                                    <Ellipse.Effect>
                                        <DropShadowEffect x:Name="ThumbGlow"
                                                          Color="#B45CFF"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"
                                                          RenderingBias="Performance" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.22" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.22" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ThumbGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.9" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetName="ThumbGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="16" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.22" />
                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.22" />
                                                <DoubleAnimation Storyboard.TargetName="ThumbGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.35" Duration="0:0:0.22" />
                                                <DoubleAnimation Storyboard.TargetName="ThumbGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="8" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="#382552" VerticalAlignment="Center" />
                                <Track x:Name="PART_Track" VerticalAlignment="Center" Height="16">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                      Background="{StaticResource AccentBrush}"
                                                      Style="{StaticResource SliderTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                      Background="Transparent"
                                                      Style="{StaticResource SliderTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SliderThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#392354" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4B2D70" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource InputBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Chrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="ComboGlow"
                                                          Color="#B45CFF"
                                                          BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Opacity="0"
                                                          RenderingBias="Performance" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <TextBlock Grid.Column="0"
                                               Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="10,0,30,0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False" />
                                        <Path Grid.Column="1"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{StaticResource MutedBrush}"
                                              StrokeThickness="1.5"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              IsHitTestVisible="False"
                                              RenderTransformOrigin="0.5,0.5" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>